diff --git a/scripts/need-build b/scripts/need-build
new file mode 100755
index 0000000..e936d97
--- /dev/null
+++ b/scripts/need-build
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -euo pipefail
+root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+kind="$1"
+destination="$(realpath "$2")"
+work="$(mktemp -d)"
+trap 'rm -rf "$work"' EXIT
+case "$kind" in
+  theme)
+    "$root/scripts/build-cursors" "$root/generated/svgs" "$work/pngs" "$work/hl" "$destination"
+    cp "$root/AUTHORS" "$root/LICENSE" "$destination/"
+    cp "$root/generated/index.theme/index.theme" "$destination/"
+    cp "$root/generated/manifest.hl/manifest.hl" "$destination/"
+    ;;
+  svgs|index.theme|manifest.hl)
+    (cd "$work"; whiskers "$root/src/templates/$kind.tera" -f mocha --overrides '{"accent":["mauve"]}')
+    source=svgs
+    if [[ "$kind" == manifest.hl ]]; then source=hl; fi
+    cp -a "$work/$source/catppuccin-mocha-mauve-cursors/." "$destination/"
+    ;;
+  *)
+    echo "error: $0: unknown product '$kind'" >&2
+    echo "help: use theme, svgs, index.theme, or manifest.hl" >&2
+    exit 1
+    ;;
+esac
diff --git a/scripts/tool-identity.py b/scripts/tool-identity.py
new file mode 100644
index 0000000..f7e4a2d
--- /dev/null
+++ b/scripts/tool-identity.py
@@ -0,0 +1,19 @@
+"""Fingerprint only the executables and Qt extension requested by a rule."""
+
+import hashlib
+import shutil
+import sys
+from pathlib import Path
+
+for name in sys.argv[1:]:
+    if name == "QtSvg":
+        from PySide6 import QtSvg
+
+        filename = QtSvg.__file__
+    else:
+        filename = shutil.which(name)
+    if filename is None:
+        sys.exit(
+            f"error: {__file__}: tool {name!r} is missing\nhelp: install it and add it to PATH"
+        )
+    print(name, hashlib.sha256(Path(filename).read_bytes()).hexdigest())
