--- /dev/null
+++ b/scripts/render-template
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+set -euo pipefail
+root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+name="$1"
+variant="${name#catppuccin-}"
+flavour="${variant%%-*}"
+accent="${variant#*-}"
+accent="${accent%-cursors}"
+cd "$2"
+for template in "$root"/src/templates/*.tera; do
+  whiskers "$template" -f "$flavour" --overrides "$(printf '{"accent":["%s"]}' "$accent")"
+done
diff --git a/scripts/tool-identity.py b/scripts/tool-identity.py
new file mode 100644
index 0000000..f7e4a2d
--- /dev/null
+++ b/scripts/tool-identity.py
@@ -0,0 +1,19 @@
+"""Fingerprint only the executables and Qt extension requested by a rule."""
+
+import hashlib
+import shutil
+import sys
+from pathlib import Path
+
+for name in sys.argv[1:]:
+    if name == "QtSvg":
+        from PySide6 import QtSvg
+
+        filename = QtSvg.__file__
+    else:
+        filename = shutil.which(name)
+    if filename is None:
+        sys.exit(
+            f"error: {__file__}: tool {name!r} is missing\nhelp: install it and add it to PATH"
+        )
+    print(name, hashlib.sha256(Path(filename).read_bytes()).hexdigest())
